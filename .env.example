# Hosted Supabase (for cloud development/deployment)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<hosted-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Optional comma-separated allowlist for origin-validated redirects/security checks.
# ALLOWED_ORIGINS=https://app.example.com,https://preview.example.com

# Optional runtime environment override for feature flags.
# Allowed: development | preview | production
# APP_ENV=development

# Optional feature flag provider.
# Allowed: rules | vercel
# FEATURE_FLAGS_PROVIDER=rules
#
# To use Vercel Flags provider, add the FLAGS connection string.
# FLAGS=<vercel-flags-connection-string>
#
# Required for Vercel Flags Explorer / toolbar override encryption:
# FLAGS_SECRET=<32-byte-base64url-secret>
#
# Optional UI toggle for toolbar script outside development:
# NEXT_PUBLIC_ENABLE_VERCEL_TOOLBAR=false

# Optional feature flag overrides (comma-separated keys):
# FEATURE_FLAGS_ENABLE=selfRegistration
# FEATURE_FLAGS_DISABLE=selfRegistration

# Optional performance diagnostics:
# Server-side diagnostics are enabled by default in Vercel preview when not explicitly set.
# ENABLE_PERF_DIAGNOSTICS=true
# Client-side diagnostics require explicit opt-in.
# NEXT_PUBLIC_ENABLE_PERF_DIAGNOSTICS=true

# Optional Vercel Speed Insights toggle:
# Default behavior:
# - enabled in preview and production
# - disabled in development
# Set explicitly to "false" to disable in preview/production.
# ENABLE_VERCEL_SPEED_INSIGHTS=false
