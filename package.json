{
  "name": "pnp-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prettier": "prettier --write --ignore-unknown .",
    "prettier:check": "prettier --check --ignore-unknown",
    "supabase:start": "supabase start && ./scripts/update-local-supabase-env.sh",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:db:reset": "supabase db reset",
    "supabase:db:new": "supabase migration new",
    "supabase:link": "supabase link --project-ref \"$SUPABASE_PROJECT_REF\"",
    "supabase:push": "supabase db push --linked",
    "supabase:types": "supabase gen types typescript --linked --schema public > src/types/database.ts",
    "supabase:env:local": "./scripts/update-local-supabase-env.sh",
    "orchestrator:run": "node scripts/multi-agent-orchestrator/supervisor.mjs",
    "orchestrator:example": "node scripts/multi-agent-orchestrator/supervisor.mjs --task scripts/multi-agent-orchestrator/examples/task.mvp.json",
    "orchestrator:auto": "node scripts/multi-agent-orchestrator/auto.mjs",
    "orchestrator:chat": "node scripts/multi-agent-orchestrator/chat.mjs --mode default --approval-policy untrusted",
    "orchestrator:plan": "node scripts/multi-agent-orchestrator/chat.mjs --mode plan --approval-policy untrusted",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test",
    "test:e2e:ui": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test --ui",
    "test:e2e:install": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright install --with-deps chromium",
    "test:e2e:new": "node scripts/new-e2e-scenario.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@flags-sdk/vercel": "^1.0.1",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.96.0",
    "@tanstack/react-query": "^5.90.21",
    "@vercel/flags-core": "^1.0.1",
    "@vercel/speed-insights": "^1.3.1",
    "@vercel/toolbar": "^0.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "flags": "^4.0.3",
    "lucide-react": "^0.574.0",
    "next": "16.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-tailwindcss": "4.0.0-beta.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "shadcn": "^3.8.5",
    "supabase": "^2.76.9",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
